{
  "name": "dsh-fate-spectrum",
  "version": "0.1.0",
  "description": "四柱八字与紫微斗数排盘 Bundle for DeepSeek Harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EchoUser005/dsh-fate-spectrum.git"
  },
  "homepage": "https://github.com/EchoUser005/dsh-fate-spectrum#readme",
  "bugs": {
    "url": "https://github.com/EchoUser005/dsh-fate-spectrum/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "bazi",
    "ziwei",
    "fate-chart"
  ],
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "pnpm": "11.7.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings src tests scripts *.config.ts",
    "probe:iztro": "node scripts/probes/iztro-ziwei.mjs",
    "probe:tyme": "node scripts/probes/tyme-bazi.mjs",
    "test": "vitest run",
    "test:offline": "vitest run",
    "typecheck": "tsc --noEmit",
    "dsh:prepare": "pnpm run build && node scripts/create-dsh-dev-patch.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "dsh:smoke": "node scripts/dsh-package-smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/node": "22.20.0",
    "oxlint": "1.76.0",
    "prettier": "3.9.6",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "iztro": "2.5.8",
    "tyme4ts": "1.5.2"
  }
}
